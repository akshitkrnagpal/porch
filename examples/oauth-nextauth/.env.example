# Copy to .env.local and fill in at least one provider.

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://oauth.localhost:7462/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth client (needs a custom TLD and HTTPS; see README):
# Redirect URI: https://oauth.local.example.com:7462/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openssl rand -base64 32
NEXTAUTH_SECRET=

# Leave unset under Porch: auth.js uses PORCH_URL. Set it only to run without Porch.
# NEXTAUTH_URL=http://localhost:3000

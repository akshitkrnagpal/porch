  "license": "MIT",
  "homepage": "https://github.com/akshitkrnagpal/porch",
  "repository": { "type": "git", "url": "git+https://github.com/akshitkrnagpal/porch.git", "directory": "npm/porch-cli" },
  "keywords": ["localhost", "dev-server", "proxy", "monorepo", "portless", "https", "turborepo"],
  "bin": { "porch": "bin/porch.js" },
